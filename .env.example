# Circle Developer Controlled Wallets Configuration
# Get your API Key: https://console.circle.com/
CIRCLE_API_KEY="KEY:ENTER_YOUR_KEY_HERE"

# Entity Secret (32-byte hex string)
# Keep this SAFE. It is the root key for your wallet set.
ENTITY_SECRET="ENTER_YOUR_32_BYTE_HEX_Secret"

# Wallet Set ID (Generated via script)
WALLET_SET_ID="<GENERATED_UUID>"

# Wallet ID (Generated via script)
WALLET_ID="<GENERATED_UUID>"

# Token Config (Base Sepolia USDC)
USDC_TOKEN_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Demo Config
# The "Auditor" Agent Address (Recipient for the demo)
DEMO_AUDITOR_ADDRESS="0xe7410170f6645ad9069552154693952787c1691a"
